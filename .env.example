REMEDYGRAPH_APP_NAME=RemedyGraph API
REMEDYGRAPH_APP_VERSION=0.1.0
REMEDYGRAPH_ENVIRONMENT=development
REMEDYGRAPH_WORKSPACE_ROOT=.
REMEDYGRAPH_LLM_PROVIDER=mock
REMEDYGRAPH_FRONTEND_ORIGIN=http://localhost:5173
REMEDYGRAPH_DATABASE_PATH=:memory:
REMEDYGRAPH_MAX_MODEL_CALLS=6
REMEDYGRAPH_MAX_INVESTIGATION_ROUNDS=3
REMEDYGRAPH_MAX_FILE_BYTES=1000000
REMEDYGRAPH_MAX_INDEX_BYTES=25000000
REMEDYGRAPH_MAX_INDEX_FILES=10000
REMEDYGRAPH_RETRIEVAL_TOP_K=8
REMEDYGRAPH_GUARD_TIMEOUT_SECONDS=5
REMEDYGRAPH_GUARD_OUTPUT_LIMIT=16384
